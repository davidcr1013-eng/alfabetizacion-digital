# Copia este archivo como backend/.env y cambia los valores por los tuyos.
# backend/.env NO se sube a GitHub (está en .gitignore).

# Dirección de PostgreSQL: usuario, contraseña, servidor, puerto y nombre de la base.
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASENA@localhost:5432/alfabetizacion_digital

# Dirección del frontend que puede llamar a la API (CORS).
FRONTEND_ORIGIN=http://localhost:5173
